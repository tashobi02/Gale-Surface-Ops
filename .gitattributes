* text=auto eol=lf

# Binary data formats used by the site bundle (02 §E.1) and pipeline rasters.
*.f32 binary
*.u8 binary
*.tif binary
*.tiff binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.pdf binary
*.cmd text eol=crlf

# gale_boxwork site binaries are stored with Git LFS (2026-11-14, docs/ops/hosting.md §5; supersedes the release-asset-only
# decision in docs/ops/feasibility.md). mock_site stays a plain-Git fixture.
data/sites/gale_boxwork/tiles/** filter=lfs diff=lfs merge=lfs -text
data/sites/gale_boxwork/grid/** filter=lfs diff=lfs merge=lfs -text
data/sites/gale_boxwork/images/** filter=lfs diff=lfs merge=lfs -text
