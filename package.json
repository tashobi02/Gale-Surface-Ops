{
  "name": "cheesyspace-marswalk-planner",
  "private": true,
  "description": "Repo tooling for Marswalk Planner (NASA Space Apps 2026, team CheesySpace)",
  "license": "Apache-2.0",
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#graphify-out\" \"#.claude/skills\" \"#.claude/agents\" \"#.claude/ecc/rules\" \"#.claude/commands/orch-*.md\" \"#.claude/commands/speckit.*.md\" \"#.specify/templates\" \"#.venv\" \"#web/dist\"",
    "docs:links": "python3 scripts/check_links.py docs README.md",
    "typecheck": "npm --workspace web run typecheck",
    "build": "npm --workspace web run build",
    "test:web": "npm --workspace web run test"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.24.0"
  },
  "workspaces": [
    "web"
  ]
}
