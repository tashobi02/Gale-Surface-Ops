node_modules/
.claude/settings.local.json
# graphify: keep only the report in git
graphify-out/*
!graphify-out/GRAPH_REPORT.md
# build and environments
.venv/
__pycache__/
*.egg-info/
apps/*/dist/
# pipeline workspace: downloads and intermediates never enter git (05 §B)
pipeline/work/*
!pipeline/work/.gitkeep
# site binaries stay out of git; they ship as a GitHub release asset (docs/ops/feasibility.md)
data/sites/*/tiles/
data/sites/*/grid/
data/sites/*/images/
.releases/
# Hab Core session store (05 §B)
apps/hab-core/var/*
!apps/hab-core/var/README.md
.DS_Store
