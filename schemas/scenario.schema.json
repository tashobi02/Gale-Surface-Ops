{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tashobi02/CheesySpace-NasaSpaceAppChallenge/schemas/scenario.schema.json",
  "title": "Scenario (docs/specs/05 §C.2 Scenario, ScenarioEvent, EventLibraryEntry, TaskLibraryEntry)",
  "$comment": "plan must validate against plan-export.schema.json and its plan_hash must verify; table checksums are checked by the Hab Core loader (05 §E.7). v2 (2026-11-12, backend package 01b): mission_setup and event_library are required; plan and events are optional (a plan-less live session); stop_tasks requires plan. Cross-field rules belong to the loader (backend package 04), not to this schema: crew_count equals the number of crew entries, a vehicle ParamSet when vehicle_available, unique ids, simulated-input offsets, sample times, 1-4 tasks per POI and stop, any digit in a task text requires source_id, poi_id resolves to a POI of the Site.",
  "type": "object",
  "$defs": {
    "Provenance": {
      "enum": [
        "measured",
        "derived",
        "modelled",
        "assumed",
        "replayed",
        "simulated"
      ]
    },
    "ScenarioEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "t_utc": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "EARTH_MESSAGE",
            "DONKI_RECORD",
            "ADVISORY",
            "INJECT"
          ]
        },
        "payload": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "t_utc",
        "kind",
        "payload",
        "provenance"
      ],
      "if": {
        "properties": {
          "provenance": {
            "not": {
              "const": "simulated"
            }
          }
        }
      },
      "then": {
        "required": [
          "source_id"
        ]
      },
      "additionalProperties": false
    },
    "Table": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "StopTaskSeed": {
      "type": "object",
      "$comment": "Authored fields of 05 StopTask (FR-50). state, reason, origin, updated_* and provenance are set by the Hab Core. 1-4 tasks per stop and stop_id existing in plan are checked by the Hab Core loader.",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stop_id": {
          "type": "string",
          "minLength": 1,
          "$comment": "id of a stop Waypoint in plan (U-61)"
        },
        "crew_id": {
          "enum": [
            "EV1",
            "EV2",
            null
          ]
        },
        "kind": {
          "enum": [
            "observe",
            "image",
            "sample",
            "measure",
            "deploy",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "task_id",
        "stop_id",
        "crew_id",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "MissionSetup": {
      "type": "object",
      "$comment": "05 Scenario mission_setup (2026-11-10, Proposed); every key optional; ranges from 02 §E.3 (inclusive at both ends). The defaults of the setup screen.",
      "properties": {
        "hab_candidate_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "$comment": "FK -> HabCandidate of the Site; resolved by the loader"
        },
        "crew_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "vehicle_available": {
          "type": "boolean"
        },
        "vehicle_param_set": {
          "type": [
            "string",
            "null"
          ]
        },
        "solar_phase": {
          "enum": [
            "max",
            "min"
          ]
        },
        "max_haven_min": {
          "type": "number",
          "minimum": 5,
          "maximum": 120
        }
      },
      "additionalProperties": false
    },
    "EventLibraryInput": {
      "type": "object",
      "$comment": "05 EventLibraryEntry inputs: as ScenarioEvent but timed at t0 + t_offset_s",
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1
        },
        "t_offset_s": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "EARTH_MESSAGE",
            "DONKI_RECORD",
            "ADVISORY",
            "INJECT"
          ]
        },
        "payload": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "t_offset_s",
        "kind",
        "payload",
        "provenance"
      ],
      "if": {
        "properties": {
          "provenance": {
            "not": {
              "const": "simulated"
            }
          }
        }
      },
      "then": {
        "required": [
          "source_id"
        ]
      },
      "additionalProperties": false
    },
    "EventLibraryEntry": {
      "type": "object",
      "$comment": "05 EventLibraryEntry (2026-11-10, Proposed): started on demand by START_EVENT",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "SPACE_WEATHER"
        },
        "dose_series": {
          "type": "string",
          "minLength": 1,
          "$comment": "key in tables; the loader checks it exists"
        },
        "series_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "const": "replayed"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventLibraryInput"
          }
        }
      },
      "required": [
        "event_id",
        "title",
        "kind",
        "dose_series",
        "series_start_utc",
        "label",
        "source_id",
        "provenance"
      ],
      "additionalProperties": false
    },
    "TaskLibraryEntry": {
      "type": "object",
      "$comment": "05 TaskLibraryEntry (2026-11-10, Proposed): a suggested task for a POI (FR-54)",
      "properties": {
        "library_task_id": {
          "type": "string",
          "minLength": 1
        },
        "poi_id": {
          "type": "string",
          "minLength": 1
        },
        "crew_id": {
          "enum": [
            "EV1",
            "EV2",
            null
          ]
        },
        "kind": {
          "enum": [
            "observe",
            "image",
            "sample",
            "measure",
            "deploy",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "library_task_id",
        "poi_id",
        "crew_id",
        "kind",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "scenario_schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "data_version": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "start_utc": {
      "type": "string",
      "format": "date-time"
    },
    "plan": {
      "type": "object",
      "$comment": "PlanExport — validate with plan-export.schema.json. Optional since v2: a live session starts plan-less and the plan arrives with PUBLISH_PLAN"
    },
    "stop_tasks": {
      "type": "array",
      "$comment": "Optional (05 Scenario, FR-50); beside plan so plan_hash is unchanged (U-48)",
      "items": {
        "$ref": "#/$defs/StopTaskSeed"
      }
    },
    "mission_setup": {
      "$ref": "#/$defs/MissionSetup"
    },
    "crew": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "crew_id": {
            "enum": [
              "EV1",
              "EV2"
            ]
          },
          "suit_param_set": {
            "type": "string"
          },
          "start_offset_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "crew_id",
          "suit_param_set",
          "start_offset_s"
        ],
        "additionalProperties": false
      }
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vehicle_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pressurized_rover",
              "utility_rover"
            ]
          },
          "param_set": {
            "type": "string"
          },
          "start_x_m": {
            "type": "number"
          },
          "start_y_m": {
            "type": "number"
          }
        },
        "required": [
          "vehicle_id",
          "kind",
          "param_set",
          "start_x_m",
          "start_y_m"
        ],
        "additionalProperties": false
      }
    },
    "param_sets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "$comment": "must include one link, alert and shielding set"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioEvent"
      },
      "$comment": "Optional since v2: inputs tied to a library event move into event_library; events keeps any other scheduled input"
    },
    "tables": {
      "type": "object",
      "properties": {
        "dose_series": {
          "$ref": "#/$defs/Table"
        },
        "earth_link": {
          "$ref": "#/$defs/Table"
        }
      },
      "required": [
        "dose_series",
        "earth_link"
      ],
      "additionalProperties": false
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_library": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/EventLibraryEntry"
      }
    },
    "task_library": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskLibraryEntry"
      },
      "$comment": "Optional (05 Scenario, FR-54)"
    }
  },
  "required": [
    "scenario_schema_version",
    "scenario_id",
    "title",
    "site_id",
    "data_version",
    "seed",
    "start_utc",
    "mission_setup",
    "crew",
    "vehicles",
    "param_sets",
    "event_library",
    "tables",
    "source_ids"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "stop_tasks": [
      "plan"
    ]
  }
}
