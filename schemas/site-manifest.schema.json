{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-manifest.schema.json",
  "title": "Site manifest (docs/specs/05 §C Site)",
  "$comment": "Field names and required flags follow 05 §C. Do not add fields here without updating 05 first.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "body": {
      "enum": [
        "mars"
      ],
      "default": "mars"
    },
    "data_version": {
      "type": "string",
      "pattern": "^[a-z0-9_]+-\\d{4}\\.\\d{2}\\.\\d{2}(\\.\\d+)?$"
    },
    "crs": {
      "type": "object",
      "properties": {
        "proj4": {
          "type": "string",
          "$comment": "byte-identical to the pipeline's working-projection constant in config.py (05 §E.3)"
        },
        "base": {
          "type": "string"
        }
      },
      "required": [
        "proj4",
        "base"
      ]
    },
    "aoi": {
      "type": "object",
      "properties": {
        "extent_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "bbox_geo": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "extent_m",
        "bbox_geo"
      ]
    },
    "default_start": {
      "type": "object",
      "properties": {
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "x_m",
        "y_m",
        "label"
      ]
    },
    "known_offsets_m": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      },
      "default": {}
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataSource"
      }
    },
    "grid": {
      "$ref": "#/$defs/RoutingGrid"
    },
    "env_constants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnvConstant"
      }
    },
    "pois_asset": {
      "type": "string"
    },
    "traverse_asset": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "$comment": "target of all *_asset / asset_id FKs"
    }
  },
  "required": [
    "schema_version",
    "site_id",
    "name",
    "body",
    "data_version",
    "crs",
    "aoi",
    "default_start",
    "layers",
    "sources",
    "grid",
    "env_constants",
    "pois_asset",
    "traverse_asset",
    "assets"
  ],
  "$defs": {
    "Provenance": {
      "enum": [
        "measured",
        "derived",
        "modelled",
        "assumed",
        "replayed",
        "simulated"
      ]
    },
    "DataSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "$comment": "05: unique, kebab-case"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "authors": {
          "type": "string"
        },
        "missions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "doi": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "native_resolution_m": {
          "type": "number"
        },
        "accuracy_note": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "publisher",
        "missions",
        "instruments",
        "version",
        "url",
        "credit",
        "licence",
        "accessed"
      ]
    },
    "Layer": {
      "type": "object",
      "properties": {
        "layer_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "enum": [
            "optical",
            "topographic",
            "thermal",
            "spectral",
            "hazard",
            "mission"
          ]
        },
        "kind": {
          "enum": [
            "raster_tiles",
            "vector",
            "image_static"
          ]
        },
        "provenance": {
          "enum": [
            "measured",
            "derived",
            "modelled",
            "assumed"
          ],
          "$comment": "05: replayed and simulated are never used by static layers"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "units": {
          "type": "string"
        },
        "legend": {
          "$ref": "#/$defs/LayerLegend"
        },
        "native_resolution_m": {
          "type": "number"
        },
        "display_resolution_m": {
          "type": "number"
        },
        "asset_id": {
          "type": "string"
        },
        "tile_grid": {
          "type": "object",
          "properties": {
            "origin_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "resolutions_m": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "tile_size_px": {
              "type": "integer"
            },
            "format": {
              "type": "string"
            }
          },
          "required": [
            "origin_m",
            "resolutions_m",
            "tile_size_px",
            "format"
          ]
        },
        "default_visible": {
          "type": "boolean",
          "default": false
        },
        "optional": {
          "type": "boolean",
          "default": true,
          "$comment": "false only for basemap"
        },
        "limitations": {
          "type": "string"
        }
      },
      "required": [
        "layer_id",
        "title",
        "category",
        "kind",
        "provenance",
        "source_ids",
        "legend",
        "native_resolution_m",
        "display_resolution_m",
        "asset_id",
        "default_visible",
        "optional",
        "limitations"
      ],
      "if": {
        "properties": {
          "kind": {
            "const": "raster_tiles"
          }
        }
      },
      "then": {
        "required": [
          "tile_grid"
        ]
      }
    },
    "Asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "$comment": "relative to site folder"
        },
        "format": {
          "enum": [
            "f32",
            "u8",
            "geojson",
            "jpg",
            "png",
            "webp",
            "tiles"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "nodata": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "arrays: NaN for f32 (JSON has no NaN, so null here, as in the 05 example), 255 for u8"
        },
        "byte_order": {
          "enum": [
            "little"
          ]
        }
      },
      "required": [
        "asset_id",
        "path",
        "format",
        "sha256"
      ],
      "$comment": "05: sha256 on every asset (tiles roots store the hash of their index file); bytes on files; width/height on arrays and images; nodata and byte_order on arrays",
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "not": {
                  "const": "tiles"
                }
              }
            }
          },
          "then": {
            "required": [
              "bytes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "enum": [
                  "f32",
                  "u8",
                  "jpg",
                  "png",
                  "webp"
                ]
              }
            }
          },
          "then": {
            "required": [
              "width",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "f32"
              }
            }
          },
          "then": {
            "required": [
              "nodata",
              "byte_order"
            ],
            "properties": {
              "nodata": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "u8"
              }
            }
          },
          "then": {
            "required": [
              "nodata",
              "byte_order"
            ],
            "properties": {
              "nodata": {
                "const": 255
              }
            }
          }
        }
      ]
    },
    "RoutingGrid": {
      "type": "object",
      "properties": {
        "cell_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "origin_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "row_order": {
          "enum": [
            "north_up"
          ]
        },
        "elevation_asset": {
          "type": "string"
        },
        "slope_p90_asset": {
          "type": "string",
          "$comment": "u8, degrees × 4 (0.25° steps, 0–63.5°), 255 = no data"
        },
        "slope_max_asset": {
          "type": "string",
          "$comment": "same encoding as slope_p90_asset"
        },
        "flags_asset": {
          "type": "string"
        },
        "ti_asset": {
          "type": "string"
        },
        "ti_cell_m": {
          "type": "number",
          "$comment": "required with ti_asset; TI grid cell size, metres"
        },
        "comm_hab_asset": {
          "type": "string",
          "$comment": "v2: u8 LOS to hab mast (1/0, 255 no data)"
        },
        "hab_mast": {
          "type": "object",
          "properties": {
            "x_m": {
              "type": "number"
            },
            "y_m": {
              "type": "number"
            },
            "height_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x_m",
            "y_m",
            "height_m"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cell_m",
        "width",
        "height",
        "origin_m",
        "row_order",
        "elevation_asset",
        "slope_p90_asset",
        "slope_max_asset",
        "flags_asset",
        "comm_hab_asset",
        "hab_mast"
      ],
      "$comment": "05: width*height <= 4e6 (not expressible in JSON Schema; checked by validate_manifest)",
      "dependentRequired": {
        "ti_asset": [
          "ti_cell_m"
        ]
      }
    },
    "EnvConstant": {
      "type": "object",
      "properties": {
        "const_id": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "conditions": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "const_id",
        "quantity",
        "value",
        "low",
        "high",
        "unit",
        "conditions",
        "provenance",
        "source_id"
      ]
    },
    "POI": {
      "type": "object",
      "properties": {
        "poi_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon_e": {
          "type": "number"
        },
        "science_objective": {
          "type": "string",
          "maxLength": 300
        },
        "why_it_matters": {
          "type": "string",
          "maxLength": 300
        },
        "image_asset": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_credit": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_sol": {
          "type": [
            "integer",
            "null"
          ]
        },
        "image_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "image_camera": {
          "type": [
            "string",
            "null"
          ]
        },
        "position_source": {
          "type": "string"
        },
        "position_uncertainty_m": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "stop_type": {
          "enum": [
            "science",
            "resource",
            "engineering"
          ],
          "$comment": "v2 (01 §A.4)"
        },
        "ez_theme": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              }
            },
            "required": [
              "text",
              "source_id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "poi_id",
        "name",
        "lat",
        "lon_e",
        "science_objective",
        "why_it_matters",
        "position_source",
        "position_uncertainty_m",
        "provenance",
        "stop_type",
        "ez_theme",
        "evidence"
      ],
      "$comment": "Properties of a GeoJSON Feature in vectors/pois.geojson (05 §C POI). Image fields are absent or null when the image is unavailable (05 §E.6).",
      "if": {
        "properties": {
          "image_asset": {
            "type": "string"
          }
        },
        "required": [
          "image_asset"
        ]
      },
      "then": {
        "required": [
          "image_credit",
          "image_source_url"
        ],
        "properties": {
          "image_credit": {
            "type": "string"
          },
          "image_source_url": {
            "type": "string"
          }
        }
      }
    },
    "TraversePoint": {
      "type": "object",
      "properties": {
        "sol": {
          "type": "integer"
        },
        "site_drive": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon_e": {
          "type": "number"
        },
        "elevation_m": {
          "type": "number"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "sol",
        "source_id"
      ],
      "$comment": "Properties of GeoJSON Point features in vectors/traverse.geojson (05 §C TraversePoint)"
    },
    "LayerLegend": {
      "$comment": "C2 legend structure, decided 2026-11-06 by the data lead (T03.01). 05 says only 'ramp/classes with values'. `classes` copies the 05 §F.1 example; `ramp` and `none` were added for layers without classes or a scale.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "classes"
            },
            "breaks_follow_scenario": {
              "type": "boolean"
            },
            "classes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "items": false,
                "minItems": 3
              }
            }
          },
          "required": [
            "type",
            "classes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ramp"
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "items": false,
                "minItems": 2
              }
            }
          },
          "required": [
            "type",
            "stops"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
